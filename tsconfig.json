{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": ["bun"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["tui.tsx", "src/**/*.ts", "src/**/*.tsx", "test/**/*.tsx"]
}
